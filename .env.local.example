# Copy this file to .env.local and fill in real values. Never commit .env.local
# (already excluded via .env*.local in .gitignore).

# Google OAuth "Web application" client used for the server-side Google/Gmail
# sign-in flow (src/app/api/auth/google/route.ts). Reuse the SAME client the
# extension already uses (see GOOGLE_WEB_CLIENT_ID in
# extension/lib/firebase-config.js) — do not create a second client. In
# Google Cloud Console > APIs & Services > Credentials, open that existing
# Web-application client and add this app's callback URL
# (<NEXT_PUBLIC_SITE_URL>/api/auth/google/callback) to its Authorized redirect
# URIs, then copy the same client ID value here.
GOOGLE_WEB_CLIENT_ID=

# Client secret for that same existing Web application OAuth client (visible
# on the same Credentials page once you open it — the extension never needed
# this because its implicit flow has no client secret, but the server-side
# authorization-code exchange here does).
GOOGLE_CLIENT_SECRET=

# Public base URL of this deployed app, e.g. https://streakhire-web.azurewebsites.net
# or http://localhost:3000 for local dev. Used to build the OAuth redirect_uri
# (<NEXT_PUBLIC_SITE_URL>/api/auth/google/callback) — must exactly match a
# redirect URI registered on the Google OAuth client above.
NEXT_PUBLIC_SITE_URL=

# Full JSON contents (as a single-line string) of a Firebase/GCP service
# account key file with Firestore access, used only server-side by
# src/lib/server/firestore-admin.ts to write Gmail refresh tokens without
# going through Firestore Security Rules. Generate from Firebase Console >
# Project settings > Service accounts > Generate new private key. Keep this
# secret — it grants elevated Firestore access.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Gemini API key used only server-side by src/lib/server/gmail-sync.ts to
# classify candidate emails (sender/subject/snippet only — never full email
# body, see plans/03-gmail-first-tracker-redesign.md "Open Decision B").
# Get one at Google AI Studio (https://aistudio.google.com/apikey).
# Privacy note (Open Decision B): on the Gemini API free tier, Google may
# log/review prompt and response content to improve their products — this is
# a deliberately accepted tradeoff for staying on the free tier, not an
# oversight. Switch to a paid-tier key (which disables that logging) if that
# tradeoff isn't acceptable for the inbox contents this reaches.
GEMINI_API_KEY=

# Shared bearer secret for the Phase 4 unattended batch-sync trigger
# (src/app/api/sync/gmail/batch/route.ts), called by the scheduled GitHub
# Actions workflow (.github/workflows/gmail-sync.yml) instead of a logged-in
# user's session cookie. Generate a random value with:
#   openssl rand -hex 32
# Set the SAME value here (for local testing) and as the deployed app's
# SYNC_BATCH_SECRET (Azure App Service > Configuration > Application
# settings), AND as the SYNC_BATCH_SECRET GitHub Actions repo secret — all
# three must match exactly. Never commit the real value.
SYNC_BATCH_SECRET=
