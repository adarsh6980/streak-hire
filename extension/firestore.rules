rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user document is keyed by the user's own Firebase Auth uid.
    // A signed-in user may only read or write the document that matches
    // their own uid — never anyone else's, even though everyone shares
    // this one database.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Applications are stored as a subcollection under each user's own
      // document, so the same uid check protects them automatically.
      match /applications/{applicationId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Everything else is denied by default (no catch-all allow rule).
  }
}
